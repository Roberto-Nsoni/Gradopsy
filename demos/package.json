{
  "name": "gradopsy-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wheel": "cd .. && uv build --wheel && cp dist/gradopsy-*.whl demos/public/ && basename $(ls -t dist/gradopsy-*.whl | head -1) > demos/public/wheel.txt",
    "predev": "npm run wheel",
    "prebuild": "npm run wheel",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "cp dist/index.html dist/404.html",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
